{
  "manifest_version": 3,
  "name": "Quiz Assister for Binogi",
  "version": "1.0.1",
  "description": "Quiz assistant for binogi with a clean UI.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.binogi.se/*",
        "https://*.binogi.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
